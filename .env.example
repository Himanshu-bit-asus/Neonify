# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=

# Payments — use test credentials only for local development. Never commit a real secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DATABASE_URL=postgresql://streamify:streamify@localhost:5432/streamify?schema=public
REDIS_URL=redis://localhost:6379

# Storage / media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamify-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Supabase Storage S3-compatible credentials for local/prod media processing.
# Use the Supabase Storage S3 endpoint and a server-only access/secret key.
# Keep these values out of NEXT_PUBLIC_* variables.
IMPORTED_AUDIO_BUCKET=Songs
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_BUCKET=song-audio
# S3_ACCESS_KEY=<supabase-storage-access-key>
# S3_SECRET_KEY=<supabase-storage-secret-key>

# API integrations
# Server-side Groq key for on-demand audio transcription; never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
JWT_ACCESS_SECRET=replace-with-32-byte-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-secret
